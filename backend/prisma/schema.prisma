generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One company; users link by unique company_identifier (generated by the app).
model Company {
  id                         Int       @id @default(autoincrement())
  companyIdentifier          String?   @unique @map("company_identifier") @db.VarChar(255)
  companyName                String?   @map("company_name") @db.VarChar(255)
  registeredEmail            String?   @map("registered_email") @db.VarChar(255)
  registeredAddress          String?   @map("registered_address")
  uniqueIdentificationNumber String?   @map("unique_identification_number") @db.VarChar(255)
  gst                        String?   @map("gst") @db.VarChar(255)
  pan                        String?   @map("pan") @db.VarChar(255)
  numberOfCorporateOffices   String?   @map("number_of_corporate_offices") @db.VarChar(255)
  numberOfFactoryUnits       String?   @map("number_of_factory_units") @db.VarChar(255)
  createdAt                  DateTime? @map("created_at") @db.Timestamp(6)
  users                      IfcUser[]
  companyUnits               CompanyUnitMaster[]
  controlForms               ControlForm[]
  businessProcesses          BusinessProcessMaster[]

  @@map("companies")
}

model CompanyUnitMaster {
  id                 Int      @id @default(autoincrement())
  companyIdentifier  String?  @map("company_identifier") @db.VarChar(255)
  unitName           String?  @map("unit_name") @db.VarChar(255)
  unitAddress        String?  @map("unit_address")
  unitId             String?  @unique @map("unit_id") @db.VarChar(255)
  coordinatorEmailId String?  @map("coordinator_email_id") @db.VarChar(255)
  approverEmailId    String?  @map("approver_email_id") @db.VarChar(255)
  controlForms       ControlForm[]

  company Company? @relation(fields: [companyIdentifier], references: [companyIdentifier], onDelete: SetNull, onUpdate: Cascade)

  @@map("company_unit_master")
}

model IfcUser {
  id                    Int       @id @default(autoincrement())
  emailId               String    @unique @map("email_id") @db.VarChar(255)
  password              String    @map("password") @db.VarChar(255)
  role                  String    @map("role") @db.VarChar(50)
  createdAt             DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)
  tempLogin             Boolean?  @default(false) @map("temp_login")
  companyIdentifier     String?   @map("company_identifier") @db.VarChar(255)
  empCode               String?   @map("emp_code") @db.VarChar(255)
  empName               String?   @map("emp_name") @db.VarChar(255)
  designation           String?   @map("designation") @db.VarChar(255)
  department            String?   @map("department") @db.VarChar(255)
  mobile                String?   @map("mobile") @db.VarChar(255)
  unitId                String?   @map("unit_id") @db.VarChar(255)
  loginEmailSent        Boolean?  @default(false) @map("login_email_sent")
  tempPasswordEncrypted String?   @map("temp_password_encrypted")
  company               Company?  @relation(fields: [companyIdentifier], references: [companyIdentifier])
  auditLogs             AuditLog[]
  auditLogsRacm         AuditLogsRacm[]

  @@map("ifc_users")
}

model ControlForm {
  id                         Int       @id @default(autoincrement())
  standardControlDescription String?   @map("standard_control_description")
  subProcess                 String?   @map("sub_process") @db.VarChar(255)
  riskDescription            String?   @map("risk_description")
  whetherFraudRisksExist     String?   @map("whether_fraud_risks_exist") @db.VarChar(255)
  controlObjective           String?   @map("control_objective")
  ipeReference               String?   @map("ipe_reference")
  natureOfControl            String?   @map("nature_of_control") @db.VarChar(255)
  controlFrequency           String?   @map("control_frequency") @db.VarChar(255)
  active                     Boolean?  @default(false) @map("active")
  status                     String?   @map("status") @db.VarChar(255)
  reasonByApprover           String?   @map("reason_by_approver")
  createdAt                  DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)
  updatedAt                  DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  companyIdentifier          String?   @map("company_identifier") @db.VarChar(255)
  formId                     String?   @unique @map("form_id") @db.VarChar(255)
  unitId                     String?   @map("unit_id") @db.VarChar(255)
  remarksByUser              String?   @map("remarks_by_user")
  businessProcess            String?   @map("business_process") @db.VarChar(255)
  financialYear              String?   @map("financial_year") @db.VarChar(255)
  sampleRequired             String?   @map("sample_required")
  completeness               Boolean?  @map("completeness")
  existenceOccurrence        Boolean?  @map("existence_occurrence")
  rightsAndObligation        Boolean?  @map("rights_and_obligation")
  valuationAndAllocation     Boolean?  @map("valuation_and_allocation")
  presentationAndDisclosure  Boolean?  @map("presentation_and_disclosure")
  controlNumber              String?   @map("control_number") @db.VarChar(255)
  area                       String?   @map("area")
  riskHeat                   String?   @map("risk_heat") @db.VarChar(255)
  processWalkthrough         String?   @map("process_walkthrough")
  controlReliesOnIpe         String?   @map("control_relies_on_ipe") @db.VarChar(255)
  auditEvidenceAccuracy      String?   @map("audit_evidence_accuracy") @db.VarChar(255)
  keyControl                 String?   @map("key_control") @db.VarChar(255)
  applicationName            String?   @map("application_name") @db.VarChar(255)
  controlPerformer           String?   @map("control_performer")
  controlOwner               String?   @map("control_owner")
  controlDesignProcs         String?   @map("control_design_procs")
  controlDesignConclusion    String?   @map("control_design_conclusion") @db.VarChar(255)
  designDeficiencyDesc       String?   @map("design_deficiency_desc") @db.VarChar(255)
  sampleSize                 String?   @map("sample_size") @db.VarChar(255)
  controlTypeFo              String?   @map("control_type_fo") @db.VarChar(255)
  controlTypeMa              String?   @map("control_type_ma") @db.VarChar(255)
  dueDate                    DateTime? @map("due_date") @db.Date
  reminderFrequency          String?   @map("reminder_frequency") @db.VarChar(50)
  reminderDatetime           DateTime? @map("reminder_datetime") @db.Timestamp(6)
  sentForApprovalTimestamp   DateTime? @map("sent_for_approval_timestamp") @db.Timestamp(6)
  approvalStatusChangeTs     DateTime? @map("approval_status_change_timestamp") @db.Timestamp(6)
  pendingChanges             Boolean?  @default(false) @map("pending_changes")
  userMailSent               Boolean?  @default(false) @map("user_mail_sent")
  deficiencyActionStatus     Boolean?  @default(false) @map("deficiency_action_status")
  deficiencyResponseStatus   String?   @map("deficiency_response_status") @db.VarChar(50)
  deficiencyCaseId           String?   @map("deficiency_case_id") @db.VarChar(30)
  auditLogsRacm              AuditLogsRacm[]
  changeRequests             ChangeRequest[]
  controlFormHistory         ControlFormHistory[]
  deficiencyResponses        DeficiencyResponse[]
  sampleDocs                 SampleDoc[]
  userUploadedDocs           DocUploadedByUser[]

  company Company?            @relation(fields: [companyIdentifier], references: [companyIdentifier], onDelete: SetNull, onUpdate: Cascade)
  unit    CompanyUnitMaster?  @relation(fields: [unitId], references: [unitId], onDelete: SetNull, onUpdate: Cascade)

  @@unique([companyIdentifier, controlNumber])
  @@map("control_forms")
}

model KeyManualAiInsightsRunTable {
  id                BigInt                     @id @default(autoincrement())
  companyIdentifier String                     @map("company_identifier") @db.VarChar(255)
  modelName         String                     @map("model_name") @db.VarChar(255)
  promptVersion     String                     @map("prompt_version") @db.VarChar(100)
  status            String                     @map("status") @db.VarChar(50)
  createdAt         DateTime?                  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  rows              KeyManualAiInsightsRowData[]

  @@index([companyIdentifier])
  @@map("key_manual_ai_insights_run_table")
}

model KeyManualAiInsightsRowData {
  id                          BigInt                       @id @default(autoincrement())
  runId                       BigInt                       @map("run_id")
  companyIdentifier           String                       @map("company_identifier") @db.VarChar(255)
  formId                      String?                      @map("form_id") @db.VarChar(255)
  controlNumber               String                       @map("control_number") @db.VarChar(255)
  businessProcess             String?                      @map("business_process") @db.VarChar(255)
  rationalisationOpportunity  String                       @map("rationalisation_opportunity")
  createdAt                   DateTime?                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime?                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("updated_at") @db.Timestamp(6)
  run                         KeyManualAiInsightsRunTable  @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyIdentifier, runId, controlNumber])
  @@index([runId])
  @@index([companyIdentifier, businessProcess])
  @@map("key_manual_ai_insights_row_data")
}

model ChangeRequest {
  id                BigInt              @id @default(autoincrement())
  requestId         String              @unique @map("request_id") @db.VarChar(30)
  formId            String              @map("form_id") @db.VarChar(255)
  companyIdentifier String              @map("company_identifier") @db.VarChar(255)
  unitId            String?             @map("unit_id") @db.VarChar(255)
  requestedByEmail  String              @map("requested_by_email") @db.VarChar(255)
  requestedAt       DateTime?           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("requested_at") @db.Timestamp(6)
  status            String              @db.VarChar(50)
  reviewedByEmail   String?             @map("reviewed_by_email") @db.VarChar(255)
  requestReason     String?             @map("request_reason")
  reviewerComment   String?             @map("reviewer_comment")
  createdAt         DateTime?           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("updated_at") @db.Timestamp(6)
  controlForm       ControlForm         @relation(fields: [formId], references: [formId], onDelete: Cascade, onUpdate: Cascade)
  items             ChangeRequestItem[]

  @@map("change_request")
}

model ChangeRequestItem {
  id              BigInt        @id @default(autoincrement())
  changeRequestId BigInt        @map("change_request_id")
  fieldDbName     String        @map("field_db_name") @db.VarChar(100)
  fieldLabel      String?       @map("field_label") @db.VarChar(255)
  oldValueText    String?       @map("old_value_text")
  newValueText    String?       @map("new_value_text")
  status          String        @db.VarChar(50)
  rejectionReason String?       @map("rejection_reason")
  displayOrder    Int?          @map("display_order")
  createdAt       DateTime?     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("updated_at") @db.Timestamp(6)
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([changeRequestId, fieldDbName])
  @@map("change_request_item")
}

model ControlFormHistory {
  id                 Int        @id @default(autoincrement())
  formId             String?    @map("form_id") @db.VarChar(255)
  reasonByApprover   String?    @map("reason_by_approver")
  rejectionTimestamp DateTime?  @map("rejection_timestamp") @db.Timestamp(6)

  controlForm ControlForm? @relation(fields: [formId], references: [formId], onDelete: SetNull, onUpdate: Cascade)

  @@map("control_form_history")
}

model DeficiencyResponse {
  id                       Int                            @id @default(autoincrement())
  responseId               String                         @unique @map("response_id") @db.VarChar(30)
  formId                   String                         @map("form_id") @db.VarChar(255)
  companyIdentifier        String?                        @map("company_identifier") @db.VarChar(255)
  unitId                   String?                        @map("unit_id") @db.VarChar(255)
  responseType             String                         @map("response_type") @db.VarChar(50)
  status                   String                         @map("status") @db.VarChar(50)
  submittedByEmail         String?                        @map("submitted_by_email") @db.VarChar(255)
  submittedAt              DateTime?                      @map("submitted_at") @db.Timestamp(6)
  reviewedByEmail          String?                        @map("reviewed_by_email") @db.VarChar(255)
  reviewedAt               DateTime?                      @map("reviewed_at") @db.Timestamp(6)
  reviewDecision           String?                        @map("review_decision") @db.VarChar(50)
  reviewComment            String?                        @map("review_comment")
  currentVersion           Int                            @default(1) @map("current_version")
  explaination             String?                        @map("explaination")
  dueDate                  DateTime?                      @map("due_date") @db.Date
  concernedPerson          String?                        @map("concerned_person") @db.VarChar(255)
  createdAt                DateTime?                      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?                      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("updated_at") @db.Timestamp(6)
  controlForm              ControlForm                    @relation(fields: [formId], references: [formId], onDelete: Cascade, onUpdate: Cascade)
  submissions              DeficiencyResponseSubmission[]

  @@unique([formId])
  @@map("deficiency_response")
}

model DeficiencyResponseSubmission {
  id                    Int                           @id @default(autoincrement())
  deficiencyResponseId  Int                           @map("deficiency_response_id")
  versionNo             Int                           @map("version_no")
  submissionType        String                        @map("submission_type") @db.VarChar(50)
  status                String                        @map("status") @db.VarChar(50)
  submittedByEmail      String?                       @map("submitted_by_email") @db.VarChar(255)
  submittedAt           DateTime?                     @map("submitted_at") @db.Timestamp(6)
  reviewedByEmail       String?                       @map("reviewed_by_email") @db.VarChar(255)
  reviewedAt            DateTime?                     @map("reviewed_at") @db.Timestamp(6)
  reviewDecision        String?                       @map("review_decision") @db.VarChar(50)
  reviewComment         String?                       @map("review_comment")
  explaination          String?                       @map("explaination")
  dueDate               DateTime?                     @map("due_date") @db.Date
  concernedPerson       String?                       @map("concerned_person") @db.VarChar(255)
  createdAt             DateTime?                     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  deficiencyResponse    DeficiencyResponse            @relation(fields: [deficiencyResponseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attachments           DeficiencyResponseAttachment[]

  @@unique([deficiencyResponseId, versionNo])
  @@map("deficiency_response_submission")
}

model DeficiencyResponseAttachment {
  id             Int                          @id @default(autoincrement())
  submissionId   Int                          @map("submission_id")
  fileUrl        String                       @map("file_url") @db.VarChar(1024)
  originalName   String?                      @map("original_name") @db.VarChar(255)
  uploadedByEmail String?                     @map("uploaded_by_email") @db.VarChar(255)
  createdAt      DateTime?                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at") @db.Timestamp(6)
  submission     DeficiencyResponseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("deficiency_response_attachment")
}

model SampleDoc {
  id        Int       @id @default(autoincrement())
  formId    String?   @map("form_id") @db.VarChar(255)
  sampleDoc String?   @map("sample_doc") @db.VarChar(255)
  createdAt DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)

  controlForm ControlForm? @relation(fields: [formId], references: [formId], onDelete: SetNull, onUpdate: Cascade)

  @@map("sample_docs")
}

model DocUploadedByUser {
  id                Int       @id @default(autoincrement())
  formId            String?   @map("form_id") @db.VarChar(255)
  docUploadedByUser String?   @map("doc_uploaded_by_user") @db.VarChar(255)
  createdAt         DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)

  controlForm ControlForm? @relation(fields: [formId], references: [formId], onDelete: SetNull, onUpdate: Cascade)

  @@map("doc_uploaded_by_user")
}

model BusinessProcessMaster {
  id                  Int       @id @default(autoincrement())
  companyIdentifier   String?   @map("company_identifier") @db.VarChar(255)
  businessProcess     String    @map("business_process") @db.VarChar(255)
  businessProcessCode String    @map("business_process_code") @db.VarChar(100)
  isDefault           Boolean   @default(false) @map("is_default")
  isActive            Boolean   @default(true) @map("is_active")
  createdByEmail      String?   @map("created_by_email") @db.VarChar(255)
  updatedByEmail      String?   @map("updated_by_email") @db.VarChar(255)
  createdAt           DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at") @db.Timestamp(6)

  company Company? @relation(fields: [companyIdentifier], references: [companyIdentifier], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyIdentifier, isActive])
  @@map("business_process_master")
}

model RacmCcUser {
  id                Int       @id @default(autoincrement())
  emailId           String    @map("email_id") @db.VarChar(255)
  businessProcess   String    @map("business_process") @db.VarChar(255)
  companyIdentifier String    @map("company_identifier") @db.VarChar(255)
  unitId            String    @map("unit_id") @db.VarChar(255)
  createdAt         DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.Timestamp(6)

  @@unique([emailId, businessProcess, unitId])
  @@map("racm_cc_users")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamp(6)
  action      String?   @db.VarChar(255)
  userEmailId String?   @map("user_email_id") @db.VarChar(255)
  refData     String?   @map("ref_data")
  user        IfcUser?  @relation(fields: [userEmailId], references: [emailId], onDelete: SetNull, onUpdate: Cascade)

  @@map("audit_logs")
}

model AuditLogsRacm {
  id          Int       @id @default(autoincrement())
  timestamp   DateTime? @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamp(6)
  action      String?   @db.VarChar(255)
  userEmailId String?   @map("user_email_id") @db.VarChar(255)
  formId      String?   @map("form_id") @db.VarChar(255)
  refData     String?   @map("ref_data")
  user        IfcUser?     @relation(fields: [userEmailId], references: [emailId], onDelete: SetNull, onUpdate: Cascade)
  controlForm ControlForm? @relation(fields: [formId], references: [formId], onDelete: SetNull, onUpdate: Cascade)

  @@map("audit_logs_racm")
}
