# Shared access key — Node backend must send the same value
# Authorization: Bearer <key>   OR   X-API-Key: <key>
AI_SUMMARY_API_KEY=change-me-to-a-long-random-secret

# OpenRouter (required when dry_run=false)
OPENROUTER_API_KEY=

# OpenRouter model slug for design-gap analysis
DESIGN_GAP_MODEL=openai/gpt-5.6-terra
# Models used for design-gap analysis (active value is DESIGN_GAP_MODEL above):
# openai/gpt-4.1-mini
# anthropic/claude-opus-5.5
# anthropic/claude-sonnet-4.6
# anthropic/claude-fable-5.1
# openai/gpt-oss-20b
# openai/gpt-5.6-terra

# When true, analyze endpoints skip OpenRouter and return dry_run_txt prompts
DESIGN_GAP_DRY_RUN=false

# Risk analysis LLM. openrouter uses RISK_ANALYSIS_MODEL, or DESIGN_GAP_MODEL when that is empty.
# Set RISK_ANALYSIS_PROVIDER=ollama and RISK_ANALYSIS_OLLAMA_URL / RISK_ANALYSIS_OLLAMA_MODEL to use a local model.
RISK_ANALYSIS_PROVIDER=openrouter
RISK_ANALYSIS_MODEL=
# true = return the final prompt and do not call the model or save an analysis
RISK_ANALYSIS_DRY_RUN=false
# RISK_ANALYSIS_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# RISK_ANALYSIS_OLLAMA_MODEL=

# Key + Manual AI Insights. openrouter uses KEY_MANUAL_MODEL, or DESIGN_GAP_MODEL when that is empty.
# Set KEY_MANUAL_PROVIDER=ollama plus KEY_MANUAL_OLLAMA_URL / KEY_MANUAL_OLLAMA_MODEL to use a local model.
KEY_MANUAL_PROVIDER=openrouter
KEY_MANUAL_MODEL=
# KEY_MANUAL_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# KEY_MANUAL_OLLAMA_MODEL=

# Server bind
AI_SUMMARY_HOST=127.0.0.1
AI_SUMMARY_PORT=5001
AI_SUMMARY_DEBUG=false
