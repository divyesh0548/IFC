# Shared access key — Node backend must send the same value
# Authorization: Bearer <key>   OR   X-API-Key: <key>
AI_SUMMARY_API_KEY=change-me-to-a-long-random-secret

# OpenRouter (required when dry_run=false)
OPENROUTER_API_KEY=

# Server bind
AI_SUMMARY_HOST=127.0.0.1
AI_SUMMARY_PORT=5001
AI_SUMMARY_DEBUG=false
